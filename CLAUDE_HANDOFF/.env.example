# SAFE NAMES / PLACEHOLDERS ONLY. Put real values in the root .env manually.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://127.0.0.1:4000
PERSISTENCE_MODE=local
LOCAL_DATABASE_PATH=.private/postgres
ENABLE_TRAVEL_CONTEXT=true
ENABLE_TRAVEL_CONTEXT_PERSISTENCE=true
ENABLE_COMPANY_CATALOG=true
MODEL_PROVIDER=gemini
FALLBACK_PROVIDERS=groq
ENABLE_OPENROUTER_RUNTIME=false
ENABLE_REAL_PROVIDER=false
ENABLE_PROVIDER_STREAMING=true
PROVIDER_RETRIES=0
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
TAVILY_API_KEY=
ENABLE_TRAVEL_RESEARCH=false
ENABLE_VOICE=false
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
SUPABASE_PROJECT_REF=ujdzysbowngtkwndgoqf
SUPABASE_URL=https://ujdzysbowngtkwndgoqf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ENABLE_SUPABASE_GUEST=false
