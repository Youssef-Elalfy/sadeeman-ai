# SADEEMAN web (Next.js) for Railway. Build context: repository root.
FROM node:24.14.1-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web
COPY brand ./brand
# Workspace manifest only, so the frozen lockfile resolves; no API code.
COPY apps/api/package.json ./apps/api/package.json
# Next bakes the /api rewrite target into the build: API_ORIGIN must be the
# API service's public HTTPS Railway URL (Railway passes service variables
# as build args).
ARG API_ORIGIN
RUN case "$API_ORIGIN" in \
      https://*.up.railway.app) ;; \
      *) echo "API_ORIGIN must be the API service URL, e.g. https://<api>.up.railway.app" >&2; exit 1 ;; \
    esac
ENV API_ORIGIN=$API_ORIGIN NEXT_TELEMETRY_DISABLED=1
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @sadeeman/contracts build \
 && pnpm --filter @sadeeman/web build \
 && chown -R node:node /app/apps/web/.next
ENV NODE_ENV=production
USER node
CMD ["sh", "-c", "exec node apps/web/node_modules/next/dist/bin/next start apps/web --hostname 0.0.0.0 --port ${PORT:-3000}"]
