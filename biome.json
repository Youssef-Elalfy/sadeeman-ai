{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "apps/api/src/**",
      "apps/web/app/**",
      "apps/web/components/**",
      "apps/web/lib/**",
      "apps/web/next.config.ts",
      "packages/contracts/src/**",
      "tests/**/*.ts",
      "tools/**/*.ts",
      "*.json",
      "vitest.config.ts",
      "!STARTER_FILE_MANIFEST.json",
      "playwright.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
