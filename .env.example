# EXAMPLES ONLY — no secrets are included. Copy to .env only for local development.
NODE_ENV=development
APP_NAME=SADEEMAN AI
WEB_ORIGIN=http://localhost:3000
PORT=4000
MODEL_PROVIDER=gemini
GEMINI_MODEL=CHECK_SUPPORTED_MODEL_IN_CONSOLE
GEMINI_API_KEY=
GROQ_MODEL=CHECK_SUPPORTED_MODEL_IN_CONSOLE
GROQ_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
DATABASE_URL=
SUPABASE_URL=
# Legacy/future operator fields below are not consumed by the current runtime.
# Use SUPABASE_PUBLISHABLE_KEY for hosted requests. Never configure a service-role key in a client.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ALLOW_DEMO_FIXTURES=true
ENABLE_REAL_PROVIDER=false
ENABLE_PROVIDER_STREAMING=false
# Keep ephemeral mode for the original M1 path; choose local for real disk-backed PostgreSQL development.
PERSISTENCE_MODE=ephemeral
LOCAL_DATABASE_PATH=.private/postgres
# Hosted Supabase is opt-in. URL must match this verified project ref exactly.
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
ENABLE_SUPABASE_GUEST=false
# Backend guest limiter is per process/IP; Supabase direct Auth needs its own controls.
GUEST_RATE_LIMIT_MAX=5
# Opt in only alongside an approved real CAPTCHA configuration; no Auth setting is changed by this flag.
REQUIRE_GUEST_CAPTCHA=false
# Ordinary development uses real model replies with public, nonsensitive input.
# This flag is allowed only in an explicitly selected NODE_ENV=test verification process.
ALLOW_SYNTHETIC_PROVIDER_DATA=false
# Comma-separated opt-in fallback order; leave empty to contact only MODEL_PROVIDER.
FALLBACK_PROVIDERS=
ENABLE_OPENROUTER_RUNTIME=false
PROVIDER_QUOTA_COOLDOWN_MS=60000
# M3: enable only after one successful authenticated Tavily check. Always basic search, no retry.
ENABLE_TRAVEL_RESEARCH=false
MAX_SEARCH_CALLS_PER_TURN=2
MAX_SEARCH_REQUESTS_PER_HOUR=20
# M3 hardening: local proposed migration opt-in; keep disabled on Cloud until approved/applied.
ENABLE_COMPANY_CATALOG=false
ENABLE_TRAVEL_CONTEXT=false
ENABLE_TRAVEL_CONTEXT_PERSISTENCE=false
# Test-only; rejected outside NODE_ENV=test. No runtime fixture loading.
ALLOW_CATALOG_DEMO=false
ENABLE_REALTIME_VOICE=false
MAX_AGENT_TOOL_ROUNDS=5
MAX_TOOL_CALLS_PER_TURN=12
MODEL_TIMEOUT_MS=15000
TURN_TIMEOUT_MS=60000
PROVIDER_RETRIES=1
MAX_TURN_TOKENS=16000
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_CHARS=32000
# General API limit per minute for this local single-user workspace (max 120).
RATE_LIMIT_MAX=120

# The runtime never loads demo fixtures as actual company inventory.

# Genuine voice adapters: enable manually only when consenting to audio processing.
ENABLE_VOICE=false
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Web server only: loopback Fastify target, never a browser API key.
API_ORIGIN=http://127.0.0.1:4000
